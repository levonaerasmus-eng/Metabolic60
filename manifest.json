{
  "id": "m60-pwa-app",
  "name": "M60 • Feminine Metabolic Transformation",
  "short_name": "M60",
  "description": "Feminine Metabolic Strength, Tempo Cadence & Hormonal Lifestyle Sync",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#FAF6F4",
  "theme_color": "#FAF6F4",
  "orientation": "portrait-primary",
  "categories": [
    "fitness",
    "health",
    "lifestyle",
    "medical"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "note_taking": {
    "new_note_url": "./index.html?tab=train&action=new_note"
  },
  "protocol_handlers": [
    {
      "protocol": "web+m60",
      "url": "./index.html?workout=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "M60 Workout Backup",
      "accept": {
        "application/json": [".json"],
        "text/plain": [".txt"]
      }
    }
  ],
  "share_target": {
    "action": "./index.html?action=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
